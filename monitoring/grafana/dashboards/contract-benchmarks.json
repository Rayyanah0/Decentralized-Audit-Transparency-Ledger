{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "title": "Gate",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "description": "1 when the last regression check found nothing beyond the threshold. This is the series to alert on.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 1,
                  "text": "REGRESSION"
                },
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "PASS"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "audit_ledger_bench_gate_passed",
          "legendFormat": "gate",
          "refId": "A"
        }
      ],
      "title": "Regression gate",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "Cases whose resource usage grew more than the configured threshold. Anything above zero fails the build.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "audit_ledger_bench_regressions",
          "legendFormat": "regressions",
          "refId": "A"
        }
      ],
      "title": "Regressions",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "The worst single percentage increase in the run.",
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "suffix": "%",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "audit_ledger_bench_max_regression_pct",
          "legendFormat": "worst",
          "refId": "A"
        }
      ],
      "title": "Worst regression",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "Contract WASM artifact size. Coloured by `wasm_within_limit`, so a red tile means the artifact is outside the size budget the ledger accepts.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "bytes",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "options": {},
              "type": "value"
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "audit_ledger_bench_wasm_size_bytes",
          "legendFormat": "wasm",
          "refId": "A"
        },
        {
          "expr": "audit_ledger_bench_wasm_within_limit",
          "legendFormat": "within budget",
          "refId": "B"
        }
      ],
      "title": "WASM size",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "Peak resident set size of the host process that ran the suite.",
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "id": 5,
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
