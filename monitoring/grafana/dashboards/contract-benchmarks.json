    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 101,
      "title": "Cost per entry point (deterministic, gated)",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "description": "Modelled CPU instructions per unit of work, one series per case. These values come from the Soroban host's invocation metering and are reproducible across runs, so a move here is a real code change rather than runner noise.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "axisSoftMin": 0,
            "drawStyle": "line",
            "fillOpacity": 8,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "id": 10,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "topk(20, audit_ledger_bench_instructions)",
          "legendFormat": "{{suite}}/{{case}}",
          "refId": "A"
        }
      ],
      "title": "Most expensive entry points (instructions/unit)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "Simulated transaction fee per unit, in stroops.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "axisSoftMin": 0,
            "drawStyle": "line",
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "short"
