        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "id": 104,
      "title": "Wall clock (advisory only \u2014 never gated)",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "description": "Median host wall-clock per unit. Deliberately excluded from the regression gate: it measures the CI runner, not the contract. Useful only for spotting a case that became pathologically slow.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "\u00b5s"
