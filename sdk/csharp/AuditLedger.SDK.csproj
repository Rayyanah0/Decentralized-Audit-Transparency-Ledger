<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net6.0;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>AuditLedger.SDK</PackageId>
    <Version>1.0.0</Version>
    <Authors>progidyken-hub, Decentralized Audit Transparency Ledger Contributors</Authors>
    <Company>Decentralized Audit Transparency Ledger</Company>
    <Description>Official C# / .NET SDK for AuditLedger with async/await, Microsoft.Extensions dependency injection, Unity and Blazor WebAssembly compatibility.</Description>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/daddygokings-art/Decentralized-Audit-Transparency-Ledger</PackageProjectUrl>
    <RepositoryUrl>https://github.com/daddygokings-art/Decentralized-Audit-Transparency-Ledger</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>blockchain;audit;ledger;soroban;stellar;csharp;dotnet;unity;blazor;sdk</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="6.0.0" Condition="'$(TargetFramework)' == 'net6.0'" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="2.1.0" Condition="'$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'netstandard2.1'" />
    <PackageReference Include="System.Text.Json" Version="8.0.4" Condition="'$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'netstandard2.1'" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
  </ItemGroup>

</Project>
